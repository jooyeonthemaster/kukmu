# ============================================================
# 국무노션 (GukmuNotion) 환경변수
# .env.local 에 복사하여 실제 값을 입력하세요
# ============================================================

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Anthropic API (에이전트 분석용) ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Trigger.dev (데이터 수집 파이프라인) ──
TRIGGER_SECRET_KEY=tr_dev_...

# ── Naver Open API (뉴스 검색) ──
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── BigKinds API (뉴스 빅데이터) ──
BIGKINDS_API_KEY=

# ── 공공데이터포털 API (data.go.kr) ──
DATA_GO_KR_API_KEY=

# ── KIS 한국투자증권 API (종목 데이터) ──
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_ACCOUNT_NO=
